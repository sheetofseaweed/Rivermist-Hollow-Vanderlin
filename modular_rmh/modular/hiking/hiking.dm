/// Hiked icon path -> assoc list of its states, filled on first lookup.
GLOBAL_LIST_EMPTY(hiked_icon_states)

/proc/get_hiked_icon_states(hiked_icon)
	var/list/states = GLOB.hiked_icon_states["[hiked_icon]"]
	if(!states)
		states = list()
		for(var/state in icon_states(hiked_icon))
			states[state] = TRUE
		GLOB.hiked_icon_states["[hiked_icon]"] = states
	return states

#define HEM_WEARER_SIGNALS list(COMSIG_MOVABLE_MOVED, COMSIG_MOB_APPLY_DAMAGE, COMSIG_MOB_ITEM_ATTACK, COMSIG_ATOM_ATTACKBY, COMSIG_MOB_ATTACK_HAND, COMSIG_ATOM_ATTACK_HAND)
#define HEM_GARMENT_SIGNALS list(COMSIG_MOVABLE_MOVED, COMSIG_ITEM_DROPPED, COMSIG_PARENT_QDELETING)
// Underwear shows from both sides; the crotch only from the front, the butt only from behind.
#define HEM_FRONT_REVEALS (HIDECROTCH|HIDEUNDIESBOT)
#define HEM_BACK_REVEALS (HIDEBUTT|HIDEUNDIESBOT)

/obj/item/clothing
	var/hiked = FALSE
	var/hem_reversed = FALSE
	var/hem_overlay_restore
	var/hem_sleeved_restore
	var/hem_flags_restore = NONE
	var/hem_covered_groin = FALSE
	var/mob/living/carbon/human/hem_holder
	var/list/hem_grips

/obj/item/clothing/proc/is_hikeable(reverse = FALSE)
	if(hiked)
		return TRUE
	var/list/registry = reverse ? GLOB.hiked_back_onmob_icons : GLOB.hiked_onmob_icons
	var/hiked_icon = registry["[mob_overlay_icon]"]
	if(!hiked_icon)
		return FALSE
	var/list/states = get_hiked_icon_states(hiked_icon)
	// Gendered sets such as the nun robes only ship _m and _f states.
	return states[icon_state] || states["[icon_state]_f"] || states["[icon_state]_m"]

/// Helpers can mix leg sleeves with another garment's arm sleeves, so swap only files that hike this cut.
/obj/item/clothing/proc/get_hiked_sleeves(reverse = FALSE)
	var/list/registry = reverse ? GLOB.hiked_back_sleeve_icons : GLOB.hiked_sleeve_icons
	var/hiked_sleeves = registry["[sleeved]"]
	if(!hiked_sleeves)
		return null
	var/list/states = get_hiked_icon_states(hiked_sleeves)
	if(states["r_[icon_state]"] || states["r_[icon_state]_f"])
		return hiked_sleeves
	return null

/obj/item/clothing/proc/free_hands_for_hem(mob/living/carbon/human/user)
	var/left = user.get_empty_held_index_for_side(LEFT_HANDS)
	var/right = user.get_empty_held_index_for_side(RIGHT_HANDS)
	if(!left || !right || !user.has_hand_for_held_index(left) || !user.has_hand_for_held_index(right))
		return null
	return list(left, right)

/// Raises the hem, at the back when reverse; skip_hands is for extra garments lifted by the same grips.
/obj/item/clothing/proc/toggle_hike(mob/living/carbon/human/user, skip_hands = FALSE, reverse = FALSE)
	if(hiked)
		hem_holder?.drop_hiked_hem()
		return TRUE
	if(!istype(user) || loc != user || user.is_holding(src) || !is_hikeable(reverse))
		return FALSE
	var/obj/item/hem_grip/lead
	if(skip_hands)
		lead = locate() in user.held_items
		if(!lead)
			return FALSE
	else
		var/list/free = free_hands_for_hem(user)
		if(!free)
			to_chat(user, span_warning("I need both hands free to hold up \the [src]."))
			return FALSE
		var/list/grips = list()
		for(var/index in free)
			var/obj/item/hem_grip/grip = new(user)
			grip.wearer = user
			grips += grip
			if(!user.put_in_hand(grip, index))
				for(var/obj/item/hem_grip/placed as anything in grips)
					placed.wearer = null
					qdel(placed)
				return FALSE
		hem_grips = grips
		lead = grips[1]
		lead.watch_wearer(user)
	hiked = TRUE
	hem_reversed = reverse
	hem_holder = user
	hem_overlay_restore = mob_overlay_icon
	var/list/registry = reverse ? GLOB.hiked_back_onmob_icons : GLOB.hiked_onmob_icons
	mob_overlay_icon = registry["[mob_overlay_icon]"]
	var/hiked_sleeves = get_hiked_sleeves(reverse)
	if(hiked_sleeves)
		hem_sleeved_restore = sleeved
		sleeved = hiked_sleeves
	var/reveals = reverse ? HEM_BACK_REVEALS : HEM_FRONT_REVEALS
	hem_flags_restore = flags_inv & reveals
	flags_inv &= ~reveals
	hem_covered_groin = !!(body_parts_covered & GROIN)
	body_parts_covered &= ~GROIN
	lead.watch_garment(src)
	refresh_hem_visuals(user)
	return TRUE

/obj/item/clothing/proc/lower_hem()
	if(!hiked)
		return
	var/mob/living/carbon/human/wearer = hem_holder
	hiked = FALSE
	hem_reversed = FALSE
	hem_holder = null
	mob_overlay_icon = hem_overlay_restore
	hem_overlay_restore = null
	if(hem_sleeved_restore)
		sleeved = hem_sleeved_restore
		hem_sleeved_restore = null
	flags_inv |= hem_flags_restore
	hem_flags_restore = NONE
	if(hem_covered_groin)
		body_parts_covered |= GROIN
	hem_covered_groin = FALSE
	var/list/grips = hem_grips
	hem_grips = null
	for(var/obj/item/hem_grip/grip as anything in grips)
		grip.wearer = null
		qdel(grip)
	refresh_hem_visuals(wearer)

/obj/item/clothing/proc/refresh_hem_visuals(mob/living/carbon/human/wearer)
	if(!istype(wearer) || QDELETED(wearer))
		return
	wearer.update_inv_pants()
	wearer.update_inv_shirt()
	wearer.update_inv_armor()
	wearer.update_inv_cloak()
	wearer.update_inv_undershirt()
	wearer.update_inv_belt()
	wearer.update_body_parts(redraw = TRUE)

/mob/living/carbon/human/proc/drop_hiked_hem()
	for(var/obj/item/clothing/worn in get_equipped_items())
		if(worn.hiked)
			worn.lower_hem()

/mob/living/carbon/human/proc/get_hikeable_garments(reverse = FALSE)
	var/list/found = list()
	for(var/obj/item/clothing/worn in get_equipped_items())
		if(worn.is_hikeable(reverse))
			found += worn
	return found

/mob/living/carbon/human/proc/has_hiked_hem()
	for(var/obj/item/clothing/worn in get_equipped_items())
		if(worn.hiked)
			return TRUE
	return FALSE

/mob/living/carbon/human/toggle_cmode()
	drop_hiked_hem()
	return ..()

/// Both hands hold the gathered cloth; the first grip also listens for anything that should drop it.
/obj/item/hem_grip
	name = "hem"
	desc = "A fistful of gathered cloth."
	icon = 'icons/mob/roguehudgrabs.dmi'
	icon_state = "grabbing"
	w_class = WEIGHT_CLASS_HUGE
	item_flags = ABSTRACT | DROPDEL | NOBLUDGEON
	resistance_flags = EVERYTHING_PROOF
	no_effect = TRUE
	force = 0
	throwforce = 0
	experimental_inhand = FALSE
	var/mob/living/carbon/human/wearer

/obj/item/hem_grip/dropped(mob/user, silent)
	release_hem()
	return ..()

/obj/item/hem_grip/Destroy(force)
	release_hem()
	return ..()

/// Garments keep their own signal slots for wetness and the like, so the grip does the listening.
/obj/item/hem_grip/proc/watch_wearer(mob/living/carbon/human/user)
	RegisterSignals(user, HEM_WEARER_SIGNALS, PROC_REF(on_interrupt))

/obj/item/hem_grip/proc/watch_garment(obj/item/clothing/garment)
	RegisterSignals(garment, HEM_GARMENT_SIGNALS, PROC_REF(on_interrupt))

/obj/item/hem_grip/proc/on_interrupt(datum/source)
	SIGNAL_HANDLER
	release_hem()

/obj/item/hem_grip/proc/release_hem()
	var/mob/living/carbon/human/holder = wearer
	wearer = null
	if(holder && !QDELETED(holder))
		holder.drop_hiked_hem()

/datum/emote/living/carbon/human/hike
	key = "hike"
	key_third_person = "hikes"
	message = "gathers up their hem in both hands."
	emote_type = EMOTE_VISIBLE
	restraint_check = TRUE
	var/message_lowered = "lets their hem fall."
	var/reverse = FALSE

/datum/emote/living/carbon/human/hike/can_run_emote(mob/user, status_check = TRUE, intentional)
	if(!..())
		return FALSE
	var/mob/living/carbon/human/hiker = user
	return length(hiker.get_hikeable_garments(reverse))

/datum/emote/living/carbon/human/hike/run_emote(mob/user, params, type_override, intentional, targetted)
	var/mob/living/carbon/human/hiker = user
	if(!istype(hiker))
		return FALSE
	var/list/garments = hiker.get_hikeable_garments(reverse)
	if(!length(garments))
		if(intentional)
			to_chat(hiker, span_warning("I am not wearing anything with a hem to hike."))
		return FALSE
	if(!can_run_emote(user, TRUE, intentional))
		return FALSE
	if(hiker.has_hiked_hem())
		hiker.drop_hiked_hem()
	else
		var/obj/item/clothing/first = garments[1]
		if(!first.toggle_hike(hiker, reverse = reverse))
			return FALSE
		for(var/obj/item/clothing/extra as anything in garments - first)
			extra.toggle_hike(hiker, TRUE, reverse)
	return ..()

/// Runs after the hem changed, so the text follows what actually happened.
/datum/emote/living/carbon/human/hike/select_message_type(mob/user, intentional)
	. = ..()
	var/mob/living/carbon/human/hiker = user
	if(istype(hiker) && !hiker.has_hiked_hem())
		. = message_lowered

/datum/emote/living/carbon/human/hike/reverse
	key = "hikeback"
	key_third_person = "hikesback"
	message = "gathers up the back of their hem in both hands."
	reverse = TRUE

/mob/living/carbon/human/verb/emote_hike()
	set name = "Hike Hem"
	set category = "Emotes.Silent"

	emote("hike", intentional = TRUE)

/mob/living/carbon/human/verb/emote_hike_reverse()
	set name = "Hike Hem (reverse)"
	set category = "Emotes.Silent"

	emote("hikeback", intentional = TRUE)

#undef HEM_WEARER_SIGNALS
#undef HEM_GARMENT_SIGNALS
#undef HEM_FRONT_REVEALS
#undef HEM_BACK_REVEALS
