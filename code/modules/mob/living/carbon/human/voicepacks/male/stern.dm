/datum/voicepack/male/stern/get_sound(soundin, modifiers)
	// A silenced voice makes no stern sounds either.
	if(modifiers == "silenced")
		return ..()
	var/used
	switch(soundin)
		if("jump")
			used = list('sound/vo/male/stern/jump (1).ogg', 'sound/vo/male/stern/jump (2).ogg', 'sound/vo/male/stern/jump (3).ogg', 'sound/vo/male/stern/jump (4).ogg', 'sound/vo/male/stern/jump (5).ogg')
		if("pain")
			used = list('sound/vo/male/stern/pain (1).ogg', 'sound/vo/male/stern/pain (2).ogg', 'sound/vo/male/stern/pain (3).ogg', 'sound/vo/male/stern/pain (4).ogg', 'sound/vo/male/stern/pain (5).ogg')
		if("groan")
			used = list('sound/vo/male/stern/groan (1).ogg', 'sound/vo/male/stern/groan (2).ogg', 'sound/vo/male/stern/groan (3).ogg', 'sound/vo/male/stern/groan (4).ogg', 'sound/vo/male/stern/groan (5).ogg')
		if("hmm")
			used = list('sound/vo/male/stern/hmm (1).ogg', 'sound/vo/male/stern/hmm (2).ogg')
		if("huh")
			used = list('sound/vo/male/stern/huh (1).ogg')
		if("laugh")
			used = list('sound/vo/male/stern/laugh (1).ogg', 'sound/vo/male/stern/laugh (2).ogg')
		if("chuckle")
			used = list('sound/vo/male/stern/chuckle (1).ogg', 'sound/vo/male/stern/chuckle (2).ogg', 'sound/vo/male/stern/chuckle (3).ogg')
		if("painmoan")
			used = list('sound/vo/male/stern/painmoan (1).ogg', 'sound/vo/male/stern/painmoan (2).ogg', 'sound/vo/male/stern/painmoan (3).ogg', 'sound/vo/male/stern/painmoan (4).ogg')
		if("painscream")
			used = list('sound/vo/male/stern/painscream (1).ogg', 'sound/vo/male/stern/painscream (2).ogg')
		if("paincrit")
			used = list('sound/vo/male/stern/paincrit (1).ogg', 'sound/vo/male/stern/paincrit (2).ogg')
		if("snore")
			used = list('sound/vo/male/stern/snore (1).ogg', 'sound/vo/male/stern/snore (2).ogg')

	if(!used)
		used = ..(soundin, modifiers)
	return used
