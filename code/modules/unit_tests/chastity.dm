/datum/unit_test/chastity_sprites_exist/Run()
	var/list/item_states = icon_states('modular_rmh/icons/obj/lewd/chastity.dmi')
	var/list/worn_states = icon_states('modular_rmh/icons/obj/lewd/chastity_onmob.dmi')
	for(var/obj/item/clothing/undies/chastity/device_type as anything in subtypesof(/obj/item/clothing/undies/chastity))
		var/state = initial(device_type.icon_state)
		TEST_ASSERT(state in item_states, "[device_type] is missing item state [state].")
		for(var/suffix in list("", "_f", "_dwarf", "_f_dwarf"))
			TEST_ASSERT("[state][suffix]" in worn_states, "[device_type] is missing worn state [state][suffix].")
