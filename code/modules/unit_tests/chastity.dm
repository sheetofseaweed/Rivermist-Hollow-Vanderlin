/datum/unit_test/chastity_lock_keeps_device_on/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/stripper = allocate(/mob/living/carbon/human)
	give_chastity_test_organs(human, list(ORGAN_SLOT_PENIS))
	var/obj/item/clothing/undies/chastity/cage/cage = fit_chastity_test_device(human, /obj/item/clothing/undies/chastity/cage)
	cage.lock.lock()
	TEST_ASSERT(cage.locked(), "The cage should lock.")
	TEST_ASSERT(!human.dropItemToGround(cage), "A locked cage should stay on.")
	TEST_ASSERT_EQUAL(human.underwear, cage, "A locked cage should still be worn.")
	TEST_ASSERT(!cage.canStrip(stripper, human), "A locked cage should not be strippable.")

	give_chastity_test_organs(stripper, list(ORGAN_SLOT_PENIS))
	var/obj/item/clothing/undies/chastity/cage/spare = allocate(/obj/item/clothing/undies/chastity/cage)
	TEST_ASSERT(spare.can_fit_on(stripper), "An open spare cage should fit a cock.")
	spare.lock.lock()
	TEST_ASSERT(!spare.can_fit_on(stripper), "A locked device should not fit anyone.")

	cage.lock.unlock()
	TEST_ASSERT(cage.canStrip(stripper, human), "An unlocked cage should be strippable.")
	TEST_ASSERT(human.dropItemToGround(cage), "An unlocked cage should come off.")

/datum/unit_test/chastity_key_access_and_hard_mode/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	give_chastity_test_organs(human, list(ORGAN_SLOT_PENIS))
	var/obj/item/clothing/undies/chastity/cage/cage = fit_chastity_test_device(human, /obj/item/clothing/undies/chastity/cage)
	var/datum/lock/key/chastity/cage_lock = cage.lock
	cage_lock.lock()
	var/obj/item/key/chastity/key = cage.get_generated_key()
	TEST_ASSERT_NOTNULL(key, "A device should come with its own key.")
	var/obj/item/key/copy = allocate(/obj/item/key)
	copy.lockids = key.lockids.Copy()
	var/obj/item/key/master = allocate(/obj/item/key)
	master.lockids = list(ACCESS_LORD)
	var/obj/item/storage/keyring/keyring = allocate(/obj/item/storage/keyring)
	key.forceMove(keyring)

	TEST_ASSERT(cage_lock.check_access(key), "The device's own key should fit.")
	TEST_ASSERT(cage_lock.check_access(copy), "A copied key should fit outside hard mode.")
	TEST_ASSERT(cage_lock.check_access(master), "A master key should fit outside hard mode.")
	TEST_ASSERT(cage.can_be_picked(), "A locked device should be pickable outside hard mode.")

	human.set_cached_erp_preferences(list(/datum/erp_preference/boolean/chastity_hardmode = TRUE))
	TEST_ASSERT(cage.is_hardmode_active(), "The wearer's hard mode pref should count.")
	TEST_ASSERT(cage_lock.check_access(key), "Hard mode should still accept the device's own key.")
	TEST_ASSERT(cage_lock.check_access(keyring), "Hard mode should accept a keyring holding the key.")
	TEST_ASSERT(!cage_lock.check_access(copy), "Hard mode should refuse a copied key.")
	TEST_ASSERT(!cage_lock.check_access(master), "Hard mode should refuse the master key.")
	TEST_ASSERT(!cage.can_be_picked(), "Hard mode should refuse lockpicks.")

/datum/unit_test/chastity_chisel_breaks_lock_without_harm/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/mob/living/carbon/human/smith = allocate(/mob/living/carbon/human)
	give_chastity_test_organs(human, list(ORGAN_SLOT_PENIS))
	var/obj/item/clothing/undies/chastity/cage/cage = fit_chastity_test_device(human, /obj/item/clothing/undies/chastity/cage)
	cage.lock.lock()
	var/obj/item/weapon/chisel/chisel = allocate(/obj/item/weapon/chisel)
	var/obj/item/weapon/hammer/hammer = allocate(/obj/item/weapon/hammer)
	smith.put_in_active_hand(chisel, forced = TRUE)
	smith.put_in_inactive_hand(hammer)
	TEST_ASSERT(cage.can_chisel(smith, chisel), "A chisel and hammer should be able to work the lock.")

	human.set_cached_erp_preferences(list(/datum/erp_preference/boolean/chastity_hardmode = TRUE))
	TEST_ASSERT(!cage.can_chisel(smith, chisel), "Hard mode should refuse the chisel.")
	human.set_cached_erp_preferences(list(/datum/erp_preference/boolean/chastity_hardmode = FALSE))

	var/brute_before = human.getBruteLoss()
	cage.break_lock(smith)
	TEST_ASSERT_NULL(human.underwear, "A broken lock should free the wearer.")
	TEST_ASSERT(isturf(cage.loc), "With both hands on the tools, the freed device should fall to the floor.")
	TEST_ASSERT_EQUAL(human.getBruteLoss(), brute_before, "Chiselling should never hurt the wearer.")
	var/datum/lock/key/chastity/cage_lock = cage.lock
	cage_lock.try_toggle(smith, cage.get_generated_key(), FALSE)
	TEST_ASSERT(!cage.locked(), "A broken lock should never close again.")

/datum/unit_test/chastity_release_frees_locked_wearer/Run()
	var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
	var/obj/item/clothing/undies/chastity/belt/belt = fit_chastity_test_device(human, /obj/item/clothing/undies/chastity/belt)
	belt.lock.lock()
	TEST_ASSERT(human.release_chastity_device(), "Release should work on a locked device.")
	TEST_ASSERT_NULL(human.underwear, "Release should take the device off.")
	TEST_ASSERT(!belt.locked(), "A released device should be unlocked.")

