/// Gives a test human the organs in [slots].
/datum/unit_test/proc/give_chastity_test_organs(mob/living/carbon/human/human, list/slots)
	var/static/list/organ_types = list(
		ORGAN_SLOT_PENIS = /obj/item/organ/genitals/penis,
		ORGAN_SLOT_TESTICLES = /obj/item/organ/genitals/filling_organ/testicles,
		ORGAN_SLOT_VAGINA = /obj/item/organ/genitals/filling_organ/vagina,
		ORGAN_SLOT_ANUS = /obj/item/organ/genitals/filling_organ/anus,
	)
	for(var/slot in slots)
		var/obj/item/organ/organ = allocate(organ_types[slot])
		organ.Insert(human, TRUE, FALSE)

/datum/unit_test/proc/fit_chastity_test_device(mob/living/carbon/human/human, device_type)
	var/obj/item/clothing/undies/chastity/device = allocate(device_type)
	human.equip_to_slot_if_possible(device, ITEM_SLOT_UNDER_BOTTOM, disable_warning = TRUE)
	return device

/datum/unit_test/chastity_devices_block_only_their_organs/Run()
	var/list/slots = list(ORGAN_SLOT_PENIS, ORGAN_SLOT_TESTICLES, ORGAN_SLOT_VAGINA, ORGAN_SLOT_ANUS)
	for(var/device_type in subtypesof(/obj/item/clothing/undies/chastity))
		var/mob/living/carbon/human/human = allocate(/mob/living/carbon/human)
		give_chastity_test_organs(human, slots)
		var/obj/item/clothing/undies/chastity/device = fit_chastity_test_device(human, device_type)
		TEST_ASSERT_EQUAL(human.underwear, device, "[device_type] should fit a body with every organ.")
		for(var/slot in slots)
			TEST_ASSERT_EQUAL(human.is_organ_slot_blocked(slot), !!(slot in device.blocked_organ_slots), "[device_type] blocked the wrong organs at [slot].")
		TEST_ASSERT(!human.is_organ_slot_blocked(ORGAN_SLOT_TESTICLES), "[device_type] should never block the testicles.")
		TEST_ASSERT(human.dropItemToGround(device), "An unlocked [device_type] should come off.")
		for(var/slot in slots)
			TEST_ASSERT(!human.is_organ_slot_blocked(slot), "Removing [device_type] should free [slot].")

