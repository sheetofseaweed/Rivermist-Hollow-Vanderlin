/datum/culture/universal/duskmar
	name = "Duskmar"
	description = "A misty duchy that holds Rivermist Hollow, Dusk Spire and the villages around them. \
	Duskmar folk argue endlessly, trade eagerly, and are quietly proud of their small home."

/datum/culture/universal/marches
	name = "Mere of Dead Men"
	pre_append = "the "
	description = "A cold salt marsh on the coast between Waterdeep and Neverwinter, made in 615 DR when the lich Iniarv called the sea down on an orc horde and the army it fought. \
	Fog, quicksand and drowned castles hide trolls, restless dead and the Cult of the Dragon, and the swamp slowly grows toward the High Road. \
	The few who live on its edge, around Leilon, are wary, grim and good with a flat-bottomed boat."

/datum/culture/universal/lantan
	name = "Lantan"
	description = "An island nation in the Trackless Sea, south of the Moonshaes, where rock gnomes and red-haired Lantanna humans worship Gond as the state faith. \
	Its inventors make smokepowder, clockwork and odd wonders, and trade them from ships with maroon sails. \
	The Spellplague took the islands away in 1385 DR and the Second Sundering brought them back; the Lantanese who returned are more secretive than ever, and their inventions are better."

/datum/culture/universal/cormyr
	name = "Cormyr"
	description = "The Forest Kingdom, ruled by House Obarskyr from Suzail and guarded by the Purple Dragons and the War Wizards. \
	Queen Raedra now rebuilds the realm after long years of war. \
	Cormyreans are loyal to the crown, fond of rank, law and paperwork, and expect an adventurer to carry a royal charter before drawing steel."

/datum/culture/universal/heartlands
	name = "Western Heartlands"
	pre_append = "the "
	description = "The wide land of hills, plains, marsh and monster-filled woods between the Sword Coast and the Storm Horn Mountains, crossed by the Trade Way. \
	No king rules it; each town, from Daggerford to Elturel, keeps its own militia, mercenaries or petty lord. \
	Heartlanders are practical, careful with strangers, and used to orcs, bandits and worse coming down the road."

/datum/culture/universal/calimshan
	name = "Calimshan"
	description = "The old empire of the far south, a land of desert, ports and the sprawl of Calimport, home of the syl-pasha and his pashas. \
	For a century genie lords and their genasi ruled here, until the human slaves rose up and drove them out in 1489 DR; the country is still learning to live free. \
	Calishites are proud and shrewd, love a good story and a hard bargain, and think of northerners as short-lived barbarians."

/datum/culture/universal/silvermarch
	name = "Silver Marches"
	pre_append = "the "
	description = "The cold northern lands around Silverymoon, the Gem of the North, with Everlund, Sundabar and the dwarf holds of Mithral Hall, Adbar and Felbarr. \
	Their cities once stood together as Luruar against the orc hordes, but the league broke apart in 1488 DR, after the last war left Sundabar in ruins. \
	Marchers are hardy, learned and proud, and still argue about whose fault that was."

/datum/culture/universal/luskan
	name = "Luskan"
	description = "The City of Sails, at the mouth of the River Mirar, ruled by High Captains whose pirate crews are called Ships. \
	After a century of ruin it became a free port where nobody asks questions, and the Arcane Brotherhood has returned to its regrown Hosttower. \
	Luskanites are hard sailors and harder bargainers, and they have hated Neverwinter for generations."

/datum/culture/universal/highforest
	name = "High Forest"
	pre_append = "the "
	description = "The greatest forest in Faerun, running from the Nether Mountains to the High Moor, with the snow-topped Star Mounts at its heart. \
	Wood elves and treants live among the ruins of old elven realms such as Eaerlann. \
	Most hollow-kin trace their families to the Hollow here, won back from their dark elven masters, and its giant trees teach them to climb before they walk."

/datum/culture/universal/hordelads
	name = "Hordelands"
	pre_append = "the "
	description = "The Endless Waste, a huge steppe between the eastern kingdoms of Faerun and Shou Lung. \
	Its horse tribes, the Tuigan best known among them, live in clans led by khans and move from water hole to water hole along the marker stones of the Golden Way. \
	Every child rides and shoots from the age of four, and the West still remembers the Great Horde that rode against it in 1359 DR."

/datum/culture/universal/waterdeep
	name = "Waterdeep"
	description = "The City of Splendors, the largest and richest city of the North, ruled by the secret Masked Lords and their one public Open Lord. \
	Guilds, noble houses and thieves all fight for its coin, and Undermountain waits beneath its streets. \
	Waterdhavians talk fast, dress well, and quietly assume the rest of the world is a suburb."

/datum/culture/universal/neverwinter
	name = "Neverwinter"
	description = "The City of Skilled Hands, famed for its craftsfolk, gardens, water clocks and coloured glass lamps, and for winters strangely mild for the North. \
	Mount Hotenow buried much of it in 1451 DR, and Lord Neverember's coin and mercenaries rebuilt it. \
	Neverwintans are stubborn builders who treat every disaster as a renovation."

/datum/culture/universal/baldursgate
	name = "Baldur's Gate"
	description = "A crowded, wealthy port on the Sword Coast, \"halfway to everywhere\". \
	The old patriar families hold the Upper City, the Flaming Fist mercenaries keep the peace, and the Artificers Guild sends its Brass Men about the streets. \
	Gate folk are street-wise and welcome anyone, so long as there is something to sell them."

/datum/culture/universal/amn
	name = "Amn"
	description = "The Merchant's Domain, a rich southern land of humans and halflings, ruled from Athkatla by a council of five great trading houses. \
	Arcane magic without a licence is a crime there, and Amnian ships trade as far as Chult and the Moonshaes. \
	Amnians are sharp bargainers who believe that everything, and everyone, has a price."

/datum/culture/universal/moonshae
	name = "Moonshae Isles"
	pre_append = "the "
	description = "Misty, windswept islands west of the Sword Coast, close to the Feywild. \
	The Ffolk keep the druid circles of the Earthmother, Northlander jarls hold the northern isles, and fey lords, fomorians and Amnian colonists rule other parts. \
	Islanders are hardy, old-fashioned, and slow to trust anyone from the mainland."

/datum/culture/universal/icewind
	name = "Icewind Dale"
	description = "A frozen tundra at the northern edge of the known world, where blizzards and the long winter night kill more folk than monsters do. \
	Most people live in Ten-Towns, a ring of rival fishing villages ruled by a council of speakers in Bryn Shander, near dwarf miners and the Reghedmen tribes. \
	Dalesfolk are blunt and practical, patient with ice and not at all with fools."

/datum/culture/universal/ambiguous
	name = "Ambiguous"
	description = "You have no clear accent, or nobody can place where you come from. \
	Others will not recognise your origin."
