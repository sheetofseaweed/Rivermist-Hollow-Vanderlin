/datum/culture/universal/duskmar
	name = "Duskmar"
	description = "A misty duchy that shelters Rivermist Hollow, Dusk Spire and the settlements around. \
	Duskmar folk bicker endlessly, trade eagerly, and take quiet pride in their own little home."

/datum/culture/universal/marches
	name = "Mere Marches"
	description = "The Mere of Dead Men, a drowned stretch of coast north of Waterdeep where sunken keeps and restless dead outnumber the living. \
	Marchers hold the High Road against the swamp with spear, torch and whatever pie the day allows, \
	and keep the grim humour of folk who bury their neighbours twice."

/datum/culture/universal/lantan
	name = "Lantan"
	description = "Gond's island of artificers, where gnome and human tinkers built wonders of gear, glass and smokepowder. \
	Those who fled remember the catastrophe vividly: the masterful doctors and steam artificers clutch the wound close, \
	driven from their workshops by the expanding scourge of rogue automaton constructs."

/datum/culture/universal/cormyr
	name = "Cormyr"
	description = "The Forest Kingdom of the Obarskyr crown, kept in order by Purple Dragon knights and the War Wizards. \
	Cormyreans love artistry, bureaucracy and the theatre of power, \
	and expect an adventurer to carry a royal charter before drawing steel."

/datum/culture/universal/heartlands
	name = "Western Heartlands"
	description = "The caravan country between Baldur's Gate and Cormyr, where no king rules \
	and every town keeps its own militia, mercenary company or petty lord. \
	Heartlanders are practical and inventive, and will talk your ear off about the road ahead."

/datum/culture/universal/calimshan
	name = "Calimshan"
	description = "The old empire of the pashas, where genie-blooded dynasties once ruled \
	and Calimport's merchant princes still count their slaves alongside their coin. \
	Calishites are proud, shrewd and theatrical, raised on intrigue, bazaars and the roar of the arenas."

/datum/culture/universal/silvermarch
	name = "Silver Marches"
	description = "The alliance of Luruar, gathered under Silverymoon, the Gem of the North, \
	where humans, elves and dwarves share one banner against the orc hordes. \
	Its people are proud, learned and well dressed, and quick to invoke the Lady Alustriel's legacy. Never ask them their opinions of Luskan."

/datum/culture/universal/luskan
	name = "Luskan"
	description = "The City of Sails, where five High Captains rule the docks and the Arcane Brotherhood watches from the Host Tower. \
	Luskanites are pirates and sell-swords at heart: grim, hard-dealing, \
	and proud of a reputation the rest of the Sword Coast calls infamy."

/datum/culture/universal/highforest
	name = "High Forest"
	description = "The great wood of the North: wood elves, treants and the ruins of Eaerlann beneath the Star Mounts. \
	Most who trace hollow-kin ancestry have family history reaching back to the Hollow here, won from their dark elven once-overlords. \
	Its mighty redwoods make Hollow Dwellers climbers before they are walkers."

/datum/culture/universal/hordelads
	name = "Hordelands"
	description = "The Endless Waste east of Faerun, home of the Tuigan horse tribes who once rode as one Great Horde against the western kingdoms. \
	Hordelanders are born in the saddle: patient, hardy archers who trust kin, horse and sky before any wall."

/datum/culture/universal/waterdeep
	name = "Waterdeep"
	description = "The City of Splendors, where every guild, noble house and back alley has its price. \
	Waterdhavians talk fast, dress well, and quietly assume the rest of the world is a suburb."

/datum/culture/universal/neverwinter
	name = "Neverwinter"
	description = "The Jewel of the North, rebuilt more times than anyone cares to count. \
	Its people are stubborn builders and craftsmen who treat every disaster as a renovation."

/datum/culture/universal/baldursgate
	name = "Baldur's Gate"
	description = "A crowded port of merchants, smugglers and patriars, where coin speaks louder than law. \
	Gate folk are street-wise, suspicious, and loyal to whoever paid last."

/datum/culture/universal/amn
	name = "Amn"
	description = "The merchant kingdom of the south, where trade houses rule and everything is for sale. \
	Amnians are sharp bargainers, wary of open magic, and never travel without a ledger."

/datum/culture/universal/moonshae
	name = "Moonshae Isles"
	description = "Windswept isles of Ffolk and Northlanders, druid circles and longships. \
	Islanders are hardy, old-fashioned, and slow to trust anyone from the mainland."

/datum/culture/universal/icewind
	name = "Icewind Dale"
	description = "Ten-Towns at the top of the world, where the wind kills faster than any monster. \
	Dalesfolk are blunt and practical, endlessly patient with ice and not at all with fools."

/datum/culture/universal/ambiguous
	name = "Ambiguous"
	description = "Either you have no distinct dialect, or society is simply ignorant to your origin. \
	You will not be recognized."
