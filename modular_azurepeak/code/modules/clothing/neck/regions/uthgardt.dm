/obj/item/clothing/neck/mercmedal/atgervi
	name = "northmanne's idol"
	desc = "A humble token of tightly-wound canvas, fur, and wood. A piece of home, clutched tight against the chest. Feel its heart beat in tyme with your own. Even here, in distant Rivermist Hollow, the gods walk, and they walk with you."
	icon = 'modular_azurepeak/icons/clothing/mercmedals.dmi'
	mob_overlay_icon = 'modular_azurepeak/icons/clothing/onmob/mercmedals.dmi'
	sleeved = null
