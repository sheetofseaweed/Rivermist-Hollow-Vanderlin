/obj/item/clothing/neck/psycross/xylix/examine(mob/user)
	. = ..()

	if(!ishuman(user))
		return

	var/mob/living/carbon/human/human = user
	if(istype(human.patron, /datum/patron/faerun/neutral_gods/Tymora))
		. += span_notice("This is an amulet of Tymora! By shift-right clicking it, I can alter its shape to whatever befits my whim.")

/obj/item/clothing/neck/psycross/xylix/ShiftRightClick(mob/user)
	if(!ishuman(user))
		return

	var/mob/living/carbon/human/human = user
	if(!istype(human.patron, /datum/patron/faerun/neutral_gods/Tymora))
		return

	var/list/psycross_types = typesof(/obj/item/clothing/neck/psycross)
	var/list/choices = list()
	for(var/type in psycross_types)
		var/obj/item/clothing/neck/psycross/cross = type
		choices[initial(cross.name)] = type

	var/selected_cross = tgui_input_list(user, "Choose the Holy symbol you would like to disguise this one as.", "Holy symbol Selection", choices)
	if(!selected_cross)
		return

	disguised_type = choices[selected_cross]
	var/obj/item/clothing/neck/psycross/cross_type = disguised_type

	name = initial(cross_type.name)
	desc = initial(cross_type.desc)
	icon = initial(cross_type.icon)
	mob_overlay_icon = initial(cross_type.mob_overlay_icon)
	icon_state = initial(cross_type.icon_state)
	item_state = initial(cross_type.item_state)

	human.regenerate_clothes()

