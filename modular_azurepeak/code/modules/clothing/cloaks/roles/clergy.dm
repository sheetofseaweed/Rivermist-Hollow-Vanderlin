	. = ..()
	. += span_info("Right-clicking this cloak allows for it to be dynamically worn as a traditional tabard, or as a sleeveless robe that partially exposes the chest.")

/obj/item/clothing/cloak/tabard/psydontabard/MiddleClick(mob/user, list/modifiers)
	..()
	user.update_inv_shirt()

/obj/item/clothing/cloak/tabard/psydontabard/attack_hand_secondary(mob/user, list/modifiers)
	switch(open_wear)
		if(FALSE)
			name = "opened Aonic tabard"
			desc = "A tabard worn by the adherents of the Holy Aonic Inquisition, peeled back to reveal its enduring innards."
			body_parts_covered = GROIN
			icon_state = "psydontabardalt"
			item_state = "psydontabardalt"
			open_wear = TRUE
			flags_inv = HIDECROTCH // BARE YOUR CHEST, NOT YOUR WEEN!
			to_chat(usr, span_warning("ENDURING, like the MARTYRS who'll guide the faithful-and-pious to PARADISE."))
		if(TRUE)
			name = "Aonic tabard"
			desc = "A tabard worn by the adherents of the Holy Aonic Inquisition. Delicate stitchwork professes the holy symbol with pride."
			body_parts_covered = CHEST|GROIN
			icon_state = "psydontabard"
			item_state = "psydontabard"
			flags_inv = HIDECROTCH|HIDEBOOB
			open_wear = FALSE
			to_chat(usr, span_warning("VEILED, like the CORPSES who've been shepherded by your steel to the AFTERLYFE."))
	update_appearance()
	if(user)
		if(ishuman(user))
			var/mob/living/carbon/H = user
			H.update_inv_cloak()
			H.update_inv_armor()
	return SECONDARY_ATTACK_CANCEL_ATTACK_CHAIN

